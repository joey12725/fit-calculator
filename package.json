{
  "name": "fit-calculator",
  "private": true,
  "description": "Measurement-driven bra-fit recommendation engine with a Next.js front end and a FastAPI service.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @fit-calculator/web dev",
